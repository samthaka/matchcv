    "multer": "^2.5.0",
    "natural": "^8.2.6",
    "nodemailer": "^10.3.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.1",
    "resend": "^6.37.0",
    "zod": "^4.6.7"
